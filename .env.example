# Base URL of the Laravel API (no trailing slash). Leave empty to use the same origin.
VITE_API_URL=http://localhost:8000
# API version prefix appended to VITE_API_URL.
VITE_API_PREFIX=/api/v1/admin
# true = serve the API from Mock Service Worker in the browser (no backend needed).
VITE_ENABLE_MOCKS=true
# Optional error-reporting DSN (e.g. Sentry). Empty disables reporting.
VITE_SENTRY_DSN=
# Real-user Web Vitals beacon endpoint (empty disables RUM).
VITE_VITALS_ENDPOINT=
