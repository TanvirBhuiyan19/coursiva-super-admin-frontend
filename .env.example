# Base URL of the Laravel API (no trailing slash). Leave EMPTY (same origin): in production nginx proxies /api and
# /sanctum to Laravel (deploy/nginx.conf); in dev run `DEV_API_PROXY=http://127.0.0.1:8000 npm run dev`.
# Sanctum SPA auth needs the session cookie to be first-party, so a cross-origin API URL is not supported.
VITE_API_URL=
# The Laravel platform API surface. The mock API (MSW) mounts on the same prefix.
VITE_API_PREFIX=/api/v1/platform
# true = serve the API from Mock Service Worker in the browser (no backend needed). Always false in production.
VITE_ENABLE_MOCKS=true
# Optional error-reporting DSN (e.g. Sentry). Empty disables reporting.
VITE_SENTRY_DSN=
# Real-user Web Vitals beacon endpoint (empty disables RUM).
VITE_VITALS_ENDPOINT=
