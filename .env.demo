# `npm run build:demo` — production build that serves the API from Mock Service Worker (for review deployments before the backend exists).
VITE_API_URL=
VITE_API_PREFIX=/api/v1/admin
VITE_ENABLE_MOCKS=true
VITE_SENTRY_DSN=
# Real-user Web Vitals beacon endpoint (empty disables RUM).
VITE_VITALS_ENDPOINT=
