# `npm run build` (production). Committed: no secrets, only where the API lives.
# The SPA is served by nginx (deploy/nginx.conf), which proxies /api and /sanctum to Laravel on the same origin,
# so Sanctum's session cookie stays first-party: leave VITE_API_URL empty.
VITE_API_URL=
VITE_API_PREFIX=/api/v1/platform
VITE_ENABLE_MOCKS=false
# Optional error-reporting DSN (e.g. Sentry). Empty disables reporting. Set it in CI, not here.
VITE_SENTRY_DSN=
# Real-user Web Vitals beacon endpoint (empty disables RUM).
VITE_VITALS_ENDPOINT=
